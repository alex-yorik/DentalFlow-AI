TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
DENTALFLOW_CLIENT=demo_dental
DENTALFLOW_CLIENTS_DIR=./clients
DENTALFLOW_CRM_PROVIDER=mock
DENTALFLOW_PORT=8080
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave unset for same-origin only (recommended), e.g. https://app.example.com
# CORS_ALLOW_ORIGINS=
NGINX_PORT=80
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false
WATCHDOG_INTERVAL=30
HEARTBEAT_INTERVAL=30
ALERT_COOLDOWN_MINUTES=15
ALERTS_CHAT_ID=
WATCHDOG_WEB_URL=http://localhost:8080/health
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7

# WhatsApp Business API (optional, requires business account)
# Empty by default: webhook verification is rejected until a token is configured
WHATSAPP_VERIFY_TOKEN=
